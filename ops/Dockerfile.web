# syntax=docker/dockerfile:1
# E02/E61: build the dashboard+checkout (apps/web) and the admin console
# (apps/admin) and serve both from nginx, which also reverse-proxies /v1 to the
# API so every browser call is same-origin (no CORS needed).
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
RUN npm ci --no-audit --no-fund --ignore-scripts
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web
COPY apps/admin ./apps/admin
ARG WEB_BASE_URL=http://localhost:8080
RUN cd apps/web && npx vite build --outDir /out/web \
 && cd ../admin && VITE_WEB_BASE_URL=${WEB_BASE_URL}/dashboard npx vite build --outDir /out/admin

FROM nginx:1.27-alpine
COPY ops/nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /out/web /usr/share/nginx/web
COPY --from=build /out/admin /usr/share/nginx/admin
EXPOSE 8080 8081
